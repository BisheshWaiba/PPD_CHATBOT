{
  "name": "postpartum-care-platform",
  "version": "1.0.0",
  "description": "Postpartum care platform: a Node.js app with a guided check-in chat, an optional AI conversation and a results report",
  "main": "server.js",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test \"test/**/*.test.js\"",
    "check:assistant": "node scripts/check-assistant.js",
    "review:pack": "node scripts/review-pack.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^7.5.3",
    "nodemailer": "^10.2.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
