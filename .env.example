# Copy this file to .env and fill in real values. .env is ignored by git.

# MongoDB connection string (see MongoDB-Setup-Guide.md).
# Without a working one, development falls back to a local user file (data/users.json)
# and production refuses to sign anyone in.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# Secret used to sign login tokens. REQUIRED in production (at least 32 random characters).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Left empty in development, a random one is created in data/.jwt-secret.
JWT_SECRET=

# How long a login lasts (default 7d). Examples: 12h, 7d
JWT_EXPIRE=7d

PORT=8004
NODE_ENV=development

# Optional: allow another website to call the API (comma separated). Off by default,
# the site and the API share one origin.
# CORS_ORIGIN=http://localhost:3000

# Optional: the command that runs Python for the chat assistant. By default "python" on
# Windows and "python3" elsewhere. Use a full path if Python is not on your PATH.
# PYTHON=python3

# Optional: how many chat greetings + messages one account may send per minute (default 30).
# Each one starts a Python process.
# CHAT_RATE_LIMIT=30

# Optional: how many saved-chat writes (new chat, messages) one account may make per minute
# (default 120). Saving happens in the background while someone chats.
# HISTORY_RATE_LIMIT=120

# Optional: the AI conversation. Leave ANTHROPIC_API_KEY empty and the chat works exactly as before,
# with its fixed, reviewed replies. With a key, open conversation (how someone feels, the baby,
# small talk) is answered by Claude. What the person types then is sent to Anthropic: see README.
# Get a key at https://console.anthropic.com, then run:  npm run check:assistant
# ANTHROPIC_API_KEY=
#
# Which model writes the replies. Default claude-opus-5-5 (about 1 to 2 cents a reply).
# claude-sonnet-5-5 costs about half as much and claude-haiku-5-5 a small fraction of that.
# ASSISTANT_MODEL=claude-opus-5-5
#
# Per account: AI replies per minute (default 12) and per day (default 150). Crisis messages are
# always answered and never counted.
# ASSISTANT_RATE_LIMIT=12
# ASSISTANT_DAILY_LIMIT=150
#
# How long to wait for the AI, in milliseconds (default 20000), and how many times to retry (default 1)
# ASSISTANT_TIMEOUT_MS=20000
# ASSISTANT_RETRIES=1

# Optional: delete each saved chat this many days after its last message. Off by default, so chats
# stay until their owner deletes them (or deletes the account). Whole days, for example 90.
# CHAT_HISTORY_DAYS=90

# Optional: email, for "forgot password" and for confirming email addresses. Any SMTP provider works
# (Gmail, Brevo, Resend, SendGrid, Mailtrap, your own server). Without SMTP_HOST, development prints
# each email in the server console instead (so you can click the link there), and production switches
# these features off. APP_URL is the public address of the site; links in emails are built from it
# and from nothing else.
# APP_URL=https://sutkeri.example.com
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=Sutkeri <no-reply@sutkeri.example.com>

# Set to true when running behind a reverse proxy (nginx, a load balancer...) so the
# sign-in rate limit sees each visitor's real IP address.
# TRUST_PROXY=true

# Optional: force the user store. "mongo" or "file". Normally leave unset.
# AUTH_STORE=
