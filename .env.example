# Copy this file to .env and fill in real values. .env is ignored by git.

# MongoDB connection string (see MongoDB-Setup-Guide.md).
# Without a working one, development falls back to a local user file (data/users.json)
# and production refuses to sign anyone in.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# Secret used to sign login tokens. REQUIRED in production (at least 32 random characters).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Left empty in development, a random one is created in data/.jwt-secret.
JWT_SECRET=

# How long a login lasts (default 7d). Examples: 12h, 7d
JWT_EXPIRE=7d

PORT=8004
NODE_ENV=development

# Optional: allow another website to call the API (comma separated). Off by default,
# the site and the API share one origin.
# CORS_ORIGIN=http://localhost:3000

# Optional: how many chat greetings + messages one account may send per minute (default 30).
# Each one starts a Python process.
# CHAT_RATE_LIMIT=30

# Set to true when running behind a reverse proxy (nginx, a load balancer...) so the
# sign-in rate limit sees each visitor's real IP address.
# TRUST_PROXY=true

# Optional: force the user store. "mongo" or "file". Normally leave unset.
# AUTH_STORE=
